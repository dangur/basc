# Tiger Data service URL (PostgreSQL + TimescaleDB), or the local docker-compose database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resilient_raleigh

# Google AI Studio key. Without it, alert and photo routes return labeled fallback copy.
GEMINI_API_KEY=

# Optional override. The civic alert service defaults to Gemini 1.5 Flash.
GEMINI_MODEL=gemini-1.5-flash

# Sentry project DSN. Leave blank to disable exporting; the SDK still no-ops safely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000

# Frontend proxy target (server-side). The browser calls same-origin /backend/*.
API_URL=http://localhost:8000
